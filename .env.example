NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Apenas no servidor (nunca NEXT_PUBLIC_*): registo com código de convite
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
REGISTRATION_INVITE_CODE=your_secret_invite_code

# LibreLinkUp (conta de seguidor — não uses credenciais da app LibreLink)
LIBRELINKUP_LOGIN=
LIBRELINKUP_PASSWORD=
# Opcional: Abbott exige versão mínima no cabeçalho; se der 403, iguala à app LibreLinkUp na loja
# LIBRELINKUP_CLIENT_VERSION=4.17.0
